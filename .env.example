POSTGRES_USER=dnd
POSTGRES_PASSWORD=dnd
POSTGRES_DB=dnd_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5435

DATABASE_URL=postgresql+asyncpg://dnd:dnd@localhost:5435/dnd_db

# Local development and CI only — do NOT set this in production. The test suite drops and
# rebuilds this database from the migrations on every run, so it must never be a database
# that matters. Leaving it unset is what stops the suite running on a deployed server.
TEST_DATABASE_URL=postgresql+asyncpg://dnd:dnd@localhost:5435/dnd_db_test

JWT_SECRET_KEY=change-me-to-a-random-secret

# How long an access token stays valid. Defaults to 15 minutes if unset. Short on purpose:
# a token cannot be revoked before it expires, so this is the window a stolen one works in.
# Raising it trades that window for fewer refresh round-trips.
ACCESS_TOKEN_EXPIRE_MINUTES=15

# How long a session lasts before signing in again, whatever it does in between. Defaults
# to 30 days if unset. The window is absolute: refreshing rotates the token but never moves
# this deadline, so it is also the longest a leaked session can survive undetected.
REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma-separated list of allowed frontend origins. Defaults to the Vite
# dev/preview ports (5173, 4173) if unset.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# The two endpoints a stranger can reach, each limited per caller address. Everything else
# is on the application-wide 100/minute, /users/refresh included — a browser refreshing on
# a timer must not be throttled like a person typing a password.
#
# Login counts attempts per minute: that is the shape of one address working a word list,
# and ten is well past what retyping a half-remembered password takes. Register counts
# accounts per hour, because nobody signs up twice a minute and a per-minute cap loose
# enough to look harmless still adds up to hundreds of accounts an hour.
#
# Raise them if many real people share one address at your deployment (an office or school
# behind one NAT). The defaults are the safe end, so leaving these unset is never the loose
# choice. Storage is in-memory: limits are per process and reset on deploy.
LOGIN_RATE_LIMIT=10/minute
REGISTER_RATE_LIMIT=5/hour

# Brevo (transactional email) — required with no default. BrevoEmailSender reads both
# with os.environ[...], so a registration or password reset 500s the instant one is
# missing, on a fresh clone as much as anywhere else. Get a key from
# https://app.brevo.com/settings/keys/api; MAIL_FROM must be a sender verified there.
BREVO_API_KEY=your-brevo-api-key
MAIL_FROM=noreply@example.com

# Discord and Google sign-in — required with no default, but only once something calls
# GoogleIdentityProvider/DiscordIdentityProvider, i.e. only if you click those buttons.
# Everything else, including `just seed`, runs without them. One app per provider:
# https://discord.com/developers/applications and
# https://console.cloud.google.com/apis/credentials. The redirect URI must be registered
# there exactly as it appears below for a plain local run.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/auth/discord/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback