# Copy to .env and fill in. Never commit the real file — it is gitignored.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=dnd
POSTGRES_PASSWORD=dnd
POSTGRES_DB=dnd_db
DATABASE_URL=postgresql+asyncpg://dnd:dnd@localhost:5435/dnd_db

# The suite runs against its own database and drops it at the start of each session.
# Required on purpose, and a dev/CI setting only: production never defines it, so the
# tests fail closed there rather than building a test database beside the real one.
TEST_DATABASE_URL=postgresql+asyncpg://dnd:dnd@localhost:5435/dnd_db_test

# --- Security ---------------------------------------------------------------
JWT_SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Mail (#38) -------------------------------------------------------------
# Brevo's transactional API key, from SMTP & API -> API Keys. Server-side only: it never
# reaches the frontend bundle, and nothing logs it.
BREVO_API_KEY=
# The address messages come from. Its domain needs SPF, DKIM and DMARC set up, or mail
# will be filtered no matter what this file says.
MAIL_FROM=noreply@lastdawn.fr
MAIL_FROM_NAME=Campaign Manager

# Where a verification link points: the SPA, not the API. The page reads the token and
# calls the endpoint, so a mail scanner that prefetches the link loads a page instead of
# spending a single-use token before the person clicks.
VERIFY_EMAIL_URL=http://localhost:5173/verify-email

# How long a verification link lives, and the two controls on asking for another. The
# per-session cap resets when you sign in; the cooldown never does, which is what stops a
# script cycling sign-in to keep sending.
VERIFICATION_TOKEN_EXPIRE_HOURS=24

# Password reset (#71). One hour rather than the day a verification link gets: a reset
# token takes the account over, so it should stop mattering sooner.
PASSWORD_RESET_URL=http://localhost:5173/reset-password
PASSWORD_RESET_EXPIRE_HOURS=1
# The one endpoint that mails an address the caller chose. Per hour, like registration.
FORGOT_PASSWORD_RATE_LIMIT=5/hour
RESENDS_PER_SESSION=3
RESEND_COOLDOWN_SECONDS=120

# --- Sign in with Discord (#39) ---------------------------------------------
# From an application in the Discord developer portal, under OAuth2. The secret is
# server-side only: it goes in the token exchange body and nowhere else, and it must never
# reach the frontend bundle or a log line.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# The exact callback URI, and it has to be registered verbatim in the portal's redirect
# allow-list — Discord compares strings, not hosts. Production is
# https://api.lastdawn.fr/auth/discord/callback; both entries live in the same application.
#
# Never derived from the incoming request. A redirect URI a caller could influence is an
# open redirect with an authorization code attached to it.
DISCORD_REDIRECT_URI=http://localhost:8000/auth/discord/callback

# Where the callback hands the browser back to: a page in the SPA, which calls
# /users/refresh and turns the cookie that was just set into an access token. No token ever
# travels in this URL — that is the whole reason the flow ends in a cookie and a redirect
# rather than a fragment.
SSO_REDIRECT_URL=http://localhost:5173/auth/callback
