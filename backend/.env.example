# Copy to .env and fill in. Never commit the real file — it is gitignored.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=dnd
POSTGRES_PASSWORD=dnd
POSTGRES_DB=dnd_db
DATABASE_URL=postgresql+asyncpg://dnd:dnd@localhost:5435/dnd_db

# The suite runs against its own database and drops it at the start of each session.
# Required on purpose, and a dev/CI setting only: production never defines it, so the
# tests fail closed there rather than building a test database beside the real one.
TEST_DATABASE_URL=postgresql+asyncpg://dnd:dnd@localhost:5435/dnd_db_test

# --- Security ---------------------------------------------------------------
JWT_SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Mail (#38) -------------------------------------------------------------
# Brevo's transactional API key, from SMTP & API -> API Keys. Server-side only: it never
# reaches the frontend bundle, and nothing logs it.
BREVO_API_KEY=
# The address messages come from. Its domain needs SPF, DKIM and DMARC set up, or mail
# will be filtered no matter what this file says.
MAIL_FROM=noreply@lastdawn.fr
MAIL_FROM_NAME=Campaign Manager

# Where a verification link points. The API's own address: following it is a GET that has
# to reach the backend.
VERIFY_EMAIL_URL=http://localhost:8000/users/verify-email

# How long a verification link lives, and the two controls on asking for another. The
# per-session cap resets when you sign in; the cooldown never does, which is what stops a
# script cycling sign-in to keep sending.
VERIFICATION_TOKEN_EXPIRE_HOURS=24
RESENDS_PER_SESSION=3
RESEND_COOLDOWN_SECONDS=120
