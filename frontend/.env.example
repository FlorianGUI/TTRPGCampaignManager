# Copy to .env.local to override. Vite only exposes variables prefixed VITE_,
# and it substitutes them at build time — so this configures the bundle, not the
# server it is served from. Production is set in .github/workflows/frontend-ci.yml.

# Where the API lives. Defaults to http://localhost:8000 if unset, which is what
# `just dev` serves. The dev (5173) and preview (4173) ports are already in the
# API's CORS_ORIGINS, and the session cookie needs that to hold: every request
# goes out with credentials, which a browser only allows against an origin the
# API names explicitly.
VITE_API_URL=http://localhost:8000