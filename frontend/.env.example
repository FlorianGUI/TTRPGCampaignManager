# Copy to .env.local to override. Vite only exposes variables prefixed VITE_,
# and it substitutes them at build time — so this configures the bundle, not the
# server it is served from.

# Where the API lives. Leave it unset: the app calls a same-origin /api, which
# nginx proxies in production and the Vite dev/preview server proxies to
# localhost:8000 (see vite.config.js). That is why nothing sets it in CI — a
# bundle with no API host in it is correct in every environment.
#
# Set it only to point a local build at an API elsewhere, and expect to deal
# with CORS and the refresh cookie yourself when you do: a cross-origin API must
# name your origin in CORS_ORIGINS (app/common/security/cors.py), and the cookie
# it sets is scoped Path=/users rather than /api/users.
# VITE_API_URL=https://api.lastdawn.fr
